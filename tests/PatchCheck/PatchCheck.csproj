<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline check: applies every CustomCheats Harmony patch against vanilla and RBM models. Run: dotnet run -project tests/PatchCheck -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <GameFolder Condition="'$(GameFolder)' == ''">D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
    <WorkshopFolder Condition="'$(WorkshopFolder)' == ''">D:\SteamLibrary\steamapps\workshop\content\261550</WorkshopFolder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="..\..\bin\Win64_Shipping_Client\CustomCheats.dll" Private="False" />
    <Reference Include="$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.Core.dll" Private="False" />
    <Reference Include="$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.CampaignSystem.dll" Private="False" />
    <Reference Include="$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.dll" Private="False" />
  </ItemGroup>

  <Target Name="WriteProbePaths" BeforeTargets="Build">
    <WriteLinesToFile File="$(OutputPath)probe.txt" Overwrite="true" Lines="$(MSBuildProjectDirectory)\..\..\bin\Win64_Shipping_Client;$(GameFolder)\bin\Win64_Shipping_Client;$(GameFolder)\Modules\SandBox\bin\Win64_Shipping_Client;$(GameFolder)\Modules\StoryMode\bin\Win64_Shipping_Client;$(WorkshopFolder)\2859188632\bin\Win64_Shipping_Client;$(WorkshopFolder)\2859238197\bin\Win64_Shipping_Client;$(WorkshopFolder)\2859232415\bin\Win64_Shipping_Client;$(WorkshopFolder)\2859222409\bin\Win64_Shipping_Client;$(WorkshopFolder)\2859251492\bin\Win64_Shipping_Client" />
  </Target>

</Project>
